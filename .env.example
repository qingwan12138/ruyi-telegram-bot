# Application
APP_HOST=127.0.0.1
APP_PORT=9878

# Telegram
# Required at service startup.
TELEGRAM_TOKEN=

# Optional when every message request supplies chat_id.
TELEGRAM_CHAT_ID=

# Optional JSON mapping from logical callback targets to HTTP(S) endpoints.
# Example: {"test-workflow":"http://127.0.0.1:9877/callback"}
CALLBACK_TARGETS_JSON=

# Optional legacy/default destination for targetless and legacy action events.
CALLBACK_FORWARD_URL=

# Optional proxy settings.
# HTTPS_PROXY is preferred for Telegram HTTPS traffic.
HTTP_PROXY=
HTTPS_PROXY=
